region            = "ap-south-1"
hosted_zone_name  = "example.com"
app_domain        = "dev.rentals.example.com"
github_repository = "your-org/vehicle-rental-platform"

# The GitHub OIDC provider is account-wide: create it in exactly one stack.
create_github_oidc_provider = true

