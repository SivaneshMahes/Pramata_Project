{
  "name": "vehicle-rental-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Vehicle Rental Management System — MERN modular monolith deployable to AWS",
  "type": "module",
  "workspaces": [
    "packages/shared-types",
    "packages/validation",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:packages": "npm run build -w @vrp/shared-types -w @vrp/validation",
    "dev:api": "npm run dev -w @vrp/api",
    "dev:web": "npm run dev -w @vrp/web",
    "seed": "npm run seed -w @vrp/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "postinstall": "npm run build:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
