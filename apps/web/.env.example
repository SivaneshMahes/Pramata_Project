# Frontend build-time settings. Only PUBLIC values belong here — anything
# prefixed VITE_ is embedded in the JavaScript bundle shipped to browsers.

# Google OAuth client ID (public). Leave empty to hide "Continue with Google".
VITE_GOOGLE_CLIENT_ID=

# Dev only: where the Vite dev server proxies /api (default http://localhost:4000).
# VITE_API_PROXY_TARGET=http://localhost:4000
