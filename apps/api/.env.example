# Copy to apps/api/.env for local development. Never commit the real file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Local Docker MongoDB runs as a single-node replica set (required for transactions).
MONGODB_URI=mongodb://localhost:27017/vehicle_rental?replicaSet=rs0&directConnection=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=86400
COOKIE_SECURE=false

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Calendar "today" for booking rules is evaluated in this timezone.
BUSINESS_TIMEZONE=Asia/Kolkata

RATE_LIMIT_ENABLED=true
ENABLE_JOBS=true

# Vehicle photo uploads (presigned S3 PUT). Locally these point at the
# S3-compatible `storage` service in docker-compose; in AWS the ECS task role
# supplies credentials and S3_ENDPOINT is left unset.
S3_BUCKET=vehicle-images
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/vehicle-images
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
